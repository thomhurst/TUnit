<?xml version="1.0" encoding="utf-8"?>
<Project>

    <ItemGroup Condition="'$(TUnitImplicitUsings)' == 'true'">
        <Using Include="TUnit.Core.HookType" Static="True" />
        <Using Include="TUnit.Core" />
    </ItemGroup>

    <!--
        EnableTUnitSourceGeneration=false (reflection mode) removes TUnit's source generator from the compilation
        entirely. The generators also check the property, but only before emitting code, so without this they would
        still analyse every test class on each build. TUnit.Analyzers stays enabled.

        Hooked after ResolveLockFileAnalyzers, where the SDK turns package analyzers into Analyzer items, so it also
        applies to IDE design-time builds.
    -->
    <Target Name="_TUnitRemoveSourceGenerator"
            AfterTargets="ResolveLockFileAnalyzers"
            Condition="'$(EnableTUnitSourceGeneration)' == 'false'">
        <ItemGroup>
            <_TUnitSourceGeneratorAnalyzer Include="@(Analyzer)" Condition="'%(Filename)' == 'TUnit.Core.SourceGenerator'" />
            <Analyzer Remove="@(_TUnitSourceGeneratorAnalyzer)" />
        </ItemGroup>
    </Target>

    <!-- Only root optional F# async support when the consuming application actually publishes it.
         A string-based DynamicDependency warns about missing FSharp.Core in C# applications. -->
    <Target Name="_TUnitPreserveFSharpAsync"
            BeforeTargets="PrepareForILLink"
            DependsOnTargets="_ComputeManagedAssemblyToLink"
            Condition="'$(PublishTrimmed)' == 'true' and '$(PublishAot)' != 'true'">
        <ItemGroup>
            <_TUnitFSharpCoreReference Include="@(ManagedAssemblyToLink)" Condition="'%(Filename)' == 'FSharp.Core'" />
            <TrimmerRootDescriptor Include="$(MSBuildThisFileDirectory)TUnit.Core.FSharp.xml"
                                   Condition="'@(_TUnitFSharpCoreReference)' != ''" />
        </ItemGroup>
    </Target>

</Project>
