<?xml version="1.0" encoding="utf-8"?>
<Project>

    <PropertyGroup Condition="'$(TUnitImplicitUsings)' == ''">
        <TUnitImplicitUsings>true</TUnitImplicitUsings>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Applies to a Polyfill package the project references itself: keeps its types out of other assemblies' view. -->
        <PolyUseEmbeddedAttribute Condition="'$(PolyUseEmbeddedAttribute)' == ''">true</PolyUseEmbeddedAttribute>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Enable TUnit source generation (defaults to true). Set to false when using reflection mode to skip source generation and improve build performance. -->
        <EnableTUnitSourceGeneration Condition="'$(EnableTUnitSourceGeneration)' == ''">true</EnableTUnitSourceGeneration>
    </PropertyGroup>

    <ItemGroup>
        <!-- Set EnableTUnitPolyfills to false to stop the source generator declaring ModuleInitializerAttribute on
             target frameworks that lack it (.NET Framework, .NET Standard). -->
        <CompilerVisibleProperty Include="EnableTUnitPolyfills" />
        <CompilerVisibleProperty Include="EnableTUnitSourceGeneration" />
    </ItemGroup>

    <!--
        Declares the TUnit.Generated namespace before the project's own files (items added here precede the SDK's
        default Compile glob) so the compiler writes the source-generated types at the end of the assembly rather
        than the start, where Microsoft Defender scans them far more slowly. See TUnit.Core.GeneratedNamespace.cs.

        This must stay in the .props: items added from a .targets land after the default glob. The condition is safe
        here even though Language is set later by the C# targets and EnableTUnitSourceGeneration may be set in the
        project body, because MSBuild evaluates every property before any item, so item conditions see final values.
        Guarded by TUnit.NugetTester's GeneratedTypeOrderTests.
    -->
    <ItemGroup Condition="'$(Language)' == 'C#' and '$(EnableTUnitSourceGeneration)' != 'false'">
        <Compile Include="$(MSBuildThisFileDirectory)TUnit.Core.GeneratedNamespace.cs" Visible="false" />
    </ItemGroup>

</Project>
