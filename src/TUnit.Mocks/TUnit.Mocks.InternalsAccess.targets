<Project>
  <!-- Experimental (#6514 Tier 2): compile-time internals access for TUnit.Mocks.
       Opt in per project with:
         <TUnitMocksExperimentalInternalsAccess>true</TUnitMocksExperimentalInternalsAccess>
         <ItemGroup><TUnitMocksInternalsAccess Include="Some.Sdk.Assembly" /></ItemGroup>
       Selected references are swapped (for the compiler only) with copies whose internals are
       public, and IgnoresAccessChecksTo is applied so CoreCLR skips accessibility checks at
       runtime. The original assemblies still ship and load; the rewritten copies never leave
       the intermediate directory. Fully inert unless the property is set. -->

  <PropertyGroup Condition="'$(TUnitMocksExperimentalInternalsAccess)' == 'true'">
    <_TUnitMocksInternalsAccessTasksTfm Condition="'$(MSBuildRuntimeType)' == 'Core'">net8.0</_TUnitMocksInternalsAccessTasksTfm>
    <_TUnitMocksInternalsAccessTasksTfm Condition="'$(_TUnitMocksInternalsAccessTasksTfm)' == ''">net472</_TUnitMocksInternalsAccessTasksTfm>

    <!-- Packaged layout: this file sits in buildTransitive/<tfm>/ (or build/netstandard2.0/),
         with the task under tasks/<tfm>/ at the package root. -->
    <TUnitMocksInternalsAccessTasksAssembly Condition="'$(TUnitMocksInternalsAccessTasksAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\tasks\$(_TUnitMocksInternalsAccessTasksTfm)\TUnit.Mocks.InternalsAccess.Tasks.dll')">$(MSBuildThisFileDirectory)..\..\tasks\$(_TUnitMocksInternalsAccessTasksTfm)\TUnit.Mocks.InternalsAccess.Tasks.dll</TUnitMocksInternalsAccessTasksAssembly>

    <!-- Repo-local layout: this file sits in src/TUnit.Mocks/, the task project beside it.
         Dev loop note: MSBuild nodes load the task assembly in-proc and hold the file lock
         across builds — run `dotnet build-server shutdown` after changing the task project. -->
    <TUnitMocksInternalsAccessTasksAssembly Condition="'$(TUnitMocksInternalsAccessTasksAssembly)' == ''">$(MSBuildThisFileDirectory)..\TUnit.Mocks.InternalsAccess.Tasks\bin\$(Configuration)\$(_TUnitMocksInternalsAccessTasksTfm)\TUnit.Mocks.InternalsAccess.Tasks.dll</TUnitMocksInternalsAccessTasksAssembly>
  </PropertyGroup>

  <UsingTask TaskName="TUnit.Mocks.InternalsAccess.Tasks.PublicizeAssemblyReferences"
             AssemblyFile="$(TUnitMocksInternalsAccessTasksAssembly)"
             Condition="'$(TUnitMocksExperimentalInternalsAccess)' == 'true'" />

  <Target Name="_TUnitMocksInternalsAccessNetFxGuard"
          BeforeTargets="CoreCompile"
          Condition="'$(TUnitMocksExperimentalInternalsAccess)' == 'true' and '@(TUnitMocksInternalsAccess)' != '' and '$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Warning Code="TUMIA002"
             Text="TUnit.Mocks internals access is inert on .NET Framework: the runtime does not honor IgnoresAccessChecksToAttribute. References were not publicized for this target." />
  </Target>

  <Target Name="TUnitMocksPublicizeReferences"
          DependsOnTargets="FindReferenceAssembliesForReferences"
          AfterTargets="FindReferenceAssembliesForReferences"
          BeforeTargets="CoreCompile"
          Condition="'$(TUnitMocksExperimentalInternalsAccess)' == 'true' and '@(TUnitMocksInternalsAccess)' != '' and '$(TargetFrameworkIdentifier)' != '.NETFramework'">

    <PropertyGroup>
      <_TUnitMocksIactSourceFile>$(IntermediateOutputPath)TUnitMocksIgnoresAccessChecksTo.g.cs</_TUnitMocksIactSourceFile>
      <!-- Set false when another package already injects IgnoresAccessChecksToAttribute into
           the compilation (would otherwise be a duplicate-type error). -->
      <TUnitMocksInternalsAccessEmitAttributeDefinition Condition="'$(TUnitMocksInternalsAccessEmitAttributeDefinition)' == ''">true</TUnitMocksInternalsAccessEmitAttributeDefinition>
      <!-- Design-time builds only: detach the project references that were publicized, so
           Roslyn-workspace tooling reads the publicized copy instead of the referenced
           project's own (un-publicized) compilation. Set false to keep the live project
           reference in the editor and accept the false CS0122 reports it produces. -->
      <TUnitMocksInternalsAccessDetachDesignTimeProjectReferences Condition="'$(TUnitMocksInternalsAccessDetachDesignTimeProjectReferences)' == ''">true</TUnitMocksInternalsAccessDetachDesignTimeProjectReferences>
    </PropertyGroup>

    <PublicizeAssemblyReferences
        ReferencePaths="@(ReferencePathWithRefAssemblies)"
        AssembliesToPublicize="@(TUnitMocksInternalsAccess)"
        RuntimeAssemblies="@(RuntimeCopyLocalItems);@(ReferenceCopyLocalPaths)"
        OutputDirectory="$(IntermediateOutputPath)tunit-mocks-internals\"
        GeneratedSourceFile="$(_TUnitMocksIactSourceFile)"
        EmitAttributeDefinition="$(TUnitMocksInternalsAccessEmitAttributeDefinition)">
      <Output TaskParameter="PublicizedReferences" ItemName="_TUnitMocksPublicizedReference" />
      <Output TaskParameter="SupersededReferences" ItemName="_TUnitMocksSupersededReference" />
    </PublicizeAssemblyReferences>

    <ItemGroup>
      <!-- Swap ONLY the compiler's view (ReferencePathWithRefAssemblies feeds Csc and nothing
           else). ReferencePath stays untouched, so copy-local outputs and deps.json keep the
           original assembly and the runtime binds to it — where IgnoresAccessChecksTo takes
           over. Superseded = the selected reference plus any same-simple-name duplicates; a
           leftover duplicate would carry the publicized copy's assembly identity (CS1703). -->
      <ReferencePathWithRefAssemblies Remove="@(_TUnitMocksSupersededReference)" />
      <ReferencePathWithRefAssemblies Include="@(_TUnitMocksPublicizedReference)" />
      <Compile Include="$(_TUnitMocksIactSourceFile)" />
      <FileWrites Include="$(_TUnitMocksIactSourceFile)" />
      <FileWrites Include="@(_TUnitMocksPublicizedReference)" />
      <FileWrites Include="@(_TUnitMocksPublicizedReference->'%(Identity).sig')" />
    </ItemGroup>

    <!-- A publicized reference that came from a ProjectReference is still a live project
         reference to Roslyn-workspace tooling (MSBuildWorkspace, the C# language server,
         OmniSharp): those hosts reference the *source compilation* of the referenced project,
         which has no publicized internals, and report a false CS0122 on every internal type
         the build accepts. Dropping the reference's compile output at design time — nothing is
         compiled or copied in a design-time build — leaves the publicized copy as the only
         reference for that assembly, so the editor sees what Csc sees. Real builds are
         untouched: the project reference still builds, copies local and lands in deps.json.
         Only applied to references this run actually publicized, so a failed publicize keeps
         the project reference intact. -->
    <ItemGroup Condition="'$(DesignTimeBuild)' == 'true' and '$(TUnitMocksInternalsAccessDetachDesignTimeProjectReferences)' == 'true'">
      <_TUnitMocksPublicizedProjectFile Include="@(_TUnitMocksPublicizedReference->'%(MSBuildSourceProjectFile)')"
                                        Condition="'%(_TUnitMocksPublicizedReference.MSBuildSourceProjectFile)' != ''" />
      <ProjectReference Update="@(_TUnitMocksPublicizedProjectFile)" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Message Importance="Low"
             Condition="'@(_TUnitMocksPublicizedProjectFile)' != ''"
             Text="TUnitMocksInternalsAccess: design-time build, detached publicized project reference(s): @(_TUnitMocksPublicizedProjectFile)" />
  </Target>
</Project>
