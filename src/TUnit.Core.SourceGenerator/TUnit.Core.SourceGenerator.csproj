<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\eng\Polyfill.targets" />

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <RootNamespace>TUnit.Core.SourceGenerator</RootNamespace>
    <PackageId>TUnit.Core.SourceGenerator</PackageId>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="CodeGenerators\Writers\Hooks\ClassHooksWriter.cs" />
    <Compile Remove="Extensions\CompilationExtensions.cs" />
    <Compile Remove="Helpers\GenericTypeInference.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with TUnit.Engine so both modes report the same [GenerateGenericTest] arity message (#7222).
         The Roslyn44/47/414 variant projects do not compile this csproj's items, so eng/Roslyn.props adds the same
         link for them; no project imports both, so the file is compiled once per project. -->
    <Compile Include="..\TUnit.Core\Helpers\GenerateGenericTestArityMessages.cs" Link="Shared\GenerateGenericTestArityMessages.cs" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="CodeGenerators\Writers\Hooks\" />
  </ItemGroup>
</Project>
