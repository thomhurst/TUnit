<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- xUnit v3 on Microsoft.Testing.Platform: global.json makes `dotnet test` MTP-only, so a VSTest
             project here could not run under `dotnet test` (and would abort a solution-wide run). -->
        <OutputType>Exe</OutputType>
        <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
        <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <!-- Source generator projects (netstandard2.0) bring in older Microsoft.Bcl.AsyncInterfaces -->
        <NoWarn>$(NoWarn);MSB3277;xUnit1051</NoWarn>
        <RootNamespace>TUnit.Assertions.SourceGenerator.IncrementalTests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="4.7.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.CodeAnalysis.Common" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\TUnit.Assertions.SourceGenerator\TUnit.Assertions.SourceGenerator.csproj" />
        <ProjectReference Include="..\..\src\TUnit.Assertions.Should.SourceGenerator\TUnit.Assertions.Should.SourceGenerator.csproj" Aliases="ShouldGenerator" />
        <ProjectReference Include="..\..\src\TUnit.Assertions\TUnit.Assertions.csproj" />
        <ProjectReference Include="..\..\src\TUnit.Core\TUnit.Core.csproj" />
        <ProjectReference Include="..\..\src\TUnit.Core.SourceGenerator.Roslyn47\TUnit.Core.SourceGenerator.Roslyn47.csproj" />
    </ItemGroup>
</Project>
