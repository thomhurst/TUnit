<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Stands in for a third-party SDK. Deliberately grants NO InternalsVisibleTo — not to the
         test assembly and not to DynamicProxyGenAssembly2 — so the internals-access pipeline is
         the only way its internal types can be reached (the case runtime auto-stubs cannot
         cover). -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
