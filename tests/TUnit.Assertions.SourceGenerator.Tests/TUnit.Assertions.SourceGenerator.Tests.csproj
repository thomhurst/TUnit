<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target to verify generator output across consumer TFMs (snapshot tests). -->
    <!-- net472 is added on Windows only; see WindowsNetFrameworkTestTarget in Directory.Build.props. -->
    <TargetFrameworks>$(WindowsNetFrameworkTestTarget)net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <Import Project="..\..\eng\TestProject.props" />

  <PropertyGroup>
    <!-- Source generator projects (netstandard2.0) bring in older Microsoft.Bcl.AsyncInterfaces -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SharedTestHelpers\TestHostReferences.cs" Link="Shared\TestHostReferences.cs" />
    <Compile Include="..\SharedTestHelpers\GeneratorTestInput.cs" Link="Shared\GeneratorTestInput.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TUnit.Assertions.SourceGenerator\TUnit.Assertions.SourceGenerator.csproj" />
    <ProjectReference Include="..\..\src\TUnit.Assertions\TUnit.Assertions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.SourceGenerators.Testing" />
    <!-- Host the generator (built against Roslyn 4.7) on the Roslyn that a current SDK loads.
         Roslyn 4.7 cannot bind fixtures that use newer syntax, such as collection expressions in
         attribute arguments, so it would snapshot what the generator does with broken input (#7190). -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" VersionOverride="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" VersionOverride="4.14.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="Sourcy.DotNet">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Sourcy.Git">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Verify" />
    <PackageReference Include="Verify.TUnit" />
  </ItemGroup>

  <Import Project="..\..\eng\TestProject.targets" />
</Project>
