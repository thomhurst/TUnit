{
  "name": "TUnit Development",
  "image": "mcr.microsoft.com/dotnet/sdk:11.0",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit"
      ],
      "settings": {
        "dotnet.defaultSolution": "TUnit.Dev.slnx"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/install-runtimes.sh && dotnet build TUnit.Dev.slnx"
}
